# Copy to .env and fill in. Never commit .env.

# --- Server ---
# Leave DASHBOARD_PASSWORD empty to disable auth (NOT recommended in production).
DASHBOARD_PASSWORD=
DASHBOARD_USER=admin

# --- Instagram Graph API (fallback; can also be set in Dashboard -> Settings) ---
GRAPH_API_VERSION=v21.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Meta Webhook ---
# App secret from developers.facebook.com -> My Apps -> App settings -> Basic.
FACEBOOK_APP_SECRET=
# Any random string; must match what you enter when subscribing the webhook.
WEBHOOK_VERIFY_TOKEN=

# --- Database ---
# Local development (default): sqlite:///./app.db
# Supabase (production): postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres
#   - <POOLER_HOST> must be COPIED from Supabase dashboard -> Connect -> Session pooler.
#     It looks like aws-1-eu-central-1.pooler.supabase.com; the number is a cluster
#     index that cannot be guessed from the region (aws-0 may be wrong!).
#   - Port 5432 = session pooler (recommended for a persistent server),
#     port 6543 = transaction pooler (serverless).
#   - Direct connection (IPv6 only): postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./app.db
